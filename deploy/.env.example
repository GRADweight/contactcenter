# Öffentlicher Hostname für Genesys (DNS A-Record auf diesen Server)
DOMAIN=voice.example.ch

# Aus der Genesys Audio-Connector-Integration (Credentials)
AUDIOHOOK_API_KEY=bitte-ersetzen

# Zufällig erzeugen: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=bitte-ersetzen

# Modelle (Stand 10/2026; vor Einsatz Lizenz und Version prüfen)
LLM_MODELL=Qwen/Qwen3-8B-AWQ
ASR_MODELL=Systran/faster-whisper-large-v3
# Deutsche Stimme: ID einer Piper-Stimme de_DE aus der speaches-Modellliste
# (GET http://speaches:8000/v1/models). Für Schweizer Klang alternativ
# Azure Speech de-CH (LeniNeural/JanNeural) als Cloud-Adapter (nur V0/V1).
TTS_MODELL=
TTS_STIMME=

# Images: Versionen vor Produktion auf Digest pinnen
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cuda
HF_TOKEN=
