# Vorlage: nach deploy/.env kopieren und ausfüllen. Diese Datei enthält bewusst
# keine Werte. Leere Pflichtfelder lassen docker compose mit einer Meldung abbrechen.

# Öffentlicher Hostname für Genesys (DNS-Eintrag auf diesen Server)
DOMAIN=

# Netzwerkadresse für Port 80/443. Leer = 127.0.0.1 (nicht öffentlich).
# Für den Betrieb mit Genesys bewusst auf 0.0.0.0 setzen.
PUBLIC_BIND_ADDR=

# Aus der Genesys-Audio-Connector-Integration: API-Key und Client Secret (Base64)
AUDIOHOOK_API_KEY=
AUDIOHOOK_CLIENT_SECRET=

# Schlüssel der Audit-Kette, mindestens 32 Zeichen, z. B.:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=

# Höchstzahl gleichzeitiger Gespräche (siehe gw-contactcenter kapazitaet / gpu)
MAX_SITZUNGEN=

# Modelle: Hugging-Face-IDs. Lizenz und Version vor Einsatz prüfen.
# Beispiel LLM: Qwen/Qwen3-8B-AWQ; Beispiel ASR: Systran/faster-whisper-large-v3
LLM_MODELL=
ASR_MODELL=
# Deutsche Piper-Stimme aus der speaches-Modellliste (GET /v1/models). Das Feld
# voice ist bei /v1/audio/speech Pflicht; für Piper genügt ein beliebiger Name.
TTS_MODELL=
TTS_STIMME=

# Nur für gesperrte Modelle auf Hugging Face
HF_TOKEN=

# Monitoring-Profil
GRAFANA_ADMIN_PASSWORD=

# Optional: andere Image-Versionen (immer mit fester Version)
VLLM_IMAGE=
SPEACHES_IMAGE=
